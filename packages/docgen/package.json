{
  "name": "@synthfall/oxc-ts-docgen",
  "version": "0.0.1",
  "description": "Core structured TypeScript metadata generator for custom docs UIs.",
  "keywords": [
    "docgen",
    "documentation",
    "metadata",
    "oxc",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EliteUser/oxc-ts-docgen.git",
    "directory": "packages/docgen"
  },
  "bugs": {
    "url": "https://github.com/EliteUser/oxc-ts-docgen/issues"
  },
  "homepage": "https://github.com/EliteUser/oxc-ts-docgen#readme",
  "bin": {
    "oxc-ts-docgen": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@oxc-project/types": "^0.137.0",
    "comment-parser": "^1.4.7",
    "oxc-parser": "^0.137.0",
    "oxc-resolver": "^11.21.3",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
