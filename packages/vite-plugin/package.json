{
  "name": "@synthfall/oxc-ts-docgen-vite",
  "version": "0.0.1",
  "description": "Vite plugin that compiles getDocs<T>() calls into structured TypeScript metadata.",
  "keywords": [
    "docgen",
    "documentation",
    "metadata",
    "typescript",
    "vite",
    "vue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EliteUser/oxc-ts-docgen.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/EliteUser/oxc-ts-docgen/issues"
  },
  "homepage": "https://github.com/EliteUser/oxc-ts-docgen#readme",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@oxc-project/types": "^0.137.0",
    "@synthfall/oxc-ts-docgen": "workspace:*",
    "oxc-parser": "^0.137.0",
    "oxc-walker": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "vite": "^8.1.0"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
