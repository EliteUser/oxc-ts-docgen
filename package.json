{
  "name": "oxc-ts-docgen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter playground run dev",
    "build": "pnpm -r run build",
    "typecheck": "tsc -b --pretty false --force",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:check": "pnpm build && node scripts/check-release-artifacts.mjs",
    "release:publish": "pnpm release:check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.12.4",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "^0.22.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.9.0"
}
