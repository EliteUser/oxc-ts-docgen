{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "tsBuildInfoFile": "../node_modules/.cache/tsc/playground.tsbuildinfo",
    "paths": {
      "@synthfall/oxc-ts-docgen": ["../packages/docgen/src/index.ts"],
      "@synthfall/oxc-ts-docgen-vite": ["../packages/vite-plugin/src/index.ts"]
    },
    "strict": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx"
  },
  "references": [{ "path": "../packages/docgen" }, { "path": "../packages/vite-plugin" }],
  "include": ["src"]
}
